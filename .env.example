# ============================================================
# WOCKKINGDAGGER HUB — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_ vars are exposed to the browser — safe to use
# in client components. All others are server-side ONLY.
# ============================================================

# ────────────────────────────────────────────────────────────
# SITE
# Set NEXT_PUBLIC_SITE_URL to your production domain.
# Used for OG tags, sitemaps, robots.txt, and Twitch embeds.
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PASSCODE=dagger

# ────────────────────────────────────────────────────────────
# YOUTUBE  (SERVER-SIDE ONLY — never expose API key)
# ─────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Go to console.cloud.google.com
#   2. Create a project → Enable YouTube Data API v3
#   3. Create an API key (restrict to YouTube Data API v3)
#   4. Get channel IDs from YouTube Studio → Settings → Channel
#   5. Playlist IDs: replace the leading "UC" with "UU"
#
# Channels:
#   Main:  @wockkingdaggerr  → YOUTUBE_CHANNEL_ID_MAIN
#   Live:  @wockkingdaggerlive → YOUTUBE_CHANNEL_ID_LIVE
# ────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID_MAIN=UCYEdpldm-qXYaT2xae1_ndQ
YOUTUBE_CHANNEL_ID_LIVE=UCFa90RcysqjyYzTTrK6F3IQ
YOUTUBE_UPLOADS_PLAYLIST_ID=UUYEdpldm-qXYaT2xae1_ndQ
YOUTUBE_UPLOADS_PLAYLIST_ID_2=UUFa90RcysqjyYzTTrK6F3IQ

# ────────────────────────────────────────────────────────────
# TWITCH  (CLIENT_ID public-safe; CLIENT_SECRET server-only)
# ─────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Go to dev.twitch.tv → Register Your Application
#   2. Set OAuth Redirect URL to http://localhost:3000
#   3. Copy Client ID and Client Secret
#
# NEXT_PUBLIC_TWITCH_PARENT_DOMAIN:
#   - Local dev: localhost
#   - Production: your-domain.com (without https://)
#   Required by Twitch for iframe embeds.
#
# Username: wockkingdaggerr (two r's)
# ────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=wockkingdaggerr
NEXT_PUBLIC_TWITCH_PARENT_DOMAIN=localhost

# ────────────────────────────────────────────────────────────
# KICK  (public API — no auth required)
# ────────────────────────────────────────────────────────────
KICK_CHANNEL_SLUG=wockkingdagger

# ────────────────────────────────────────────────────────────
# TIKTOK  (requires app approval — takes 1–4 weeks)
# ─────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Go to developers.tiktok.com → Create an app
#   2. Request video.list permission scope
#   3. Complete app review process
#   4. Generate an access token for @wockkingdaggerr
#
# WITHOUT CREDENTIALS:
#   The site shows a polished TikTok section with public profile
#   link and any videos configured in lib/featured-content.ts.
#
# Username: wockkingdaggerr (two r's)
# ────────────────────────────────────────────────────────────
TIKTOK_HANDLE=@wockkingdaggerr
TIKTOK_USERNAME=wockkingdaggerr
TIKTOK_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────
# INSTAGRAM  (requires Business/Creator account + Facebook app)
# ─────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Convert @wockkingdaggerr to a Creator account on Instagram
#   2. Create a Facebook Developer app at developers.facebook.com
#   3. Add Instagram Graph API product
#   4. Generate a long-lived access token (valid 60 days)
#   5. Copy the numeric Instagram User ID from the API response
#   6. Set up a cron job to refresh the token every 50 days
#
# WITHOUT CREDENTIALS:
#   The site shows a polished Instagram section with public profile
#   link and any posts configured in lib/featured-content.ts.
#
# Username: wockkingdaggerr (two r's)
# ────────────────────────────────────────────────────────────
INSTAGRAM_HANDLE=@wockkingdaggerr
INSTAGRAM_USERNAME=wockkingdaggerr
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────
# SUPABASE  (leave empty to run entirely on in-memory mock data)
# Without Supabase, posts are cached in memory per server
# process and reset on redeploy. Add credentials to persist.
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ────────────────────────────────────────────────────────────
# STRIPE  (leave empty for demo checkout mode)
# ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
