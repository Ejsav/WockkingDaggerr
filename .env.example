# ============================================================
# WOCKKINGDAGGER HUB — ENVIRONMENT CONTRACT
#
# Copy to .env.local for development; set the same keys in the
# Vercel project for production.
#
# RULE: only NEXT_PUBLIC_* reaches the browser. Everything else
# is server-only and is read exclusively through lib/env.ts,
# which throws if a secret is touched from client code.
#
# The "Without it" line on each variable states exactly what
# breaks. Nothing here silently degrades into fake data.
# ============================================================

# ────────────────────────────────────────────────────────────
# SITE  (public)
# ────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Drives canonical tags,
# the sitemap, OG URLs, Stripe redirects and the Twitch embed
# parent. On Vercel this falls back to the production URL.
# Without it: canonicals and Stripe redirects point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the legal pages and in the footer.
# Without it: falls back to support@<your-domain>.
NEXT_PUBLIC_CONTACT_EMAIL=

# ────────────────────────────────────────────────────────────
# SUPABASE  (required — this is the source of truth)
# ────────────────────────────────────────────────────────────
# Run every file in supabase/migrations, in order, before first use.
#
# Without the two public values: the store, the archive and the
# drop calendar all render their honest empty states. The site
# works; it just has nothing to show.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used by sync, the Stripe webhook and
# every admin mutation.
# Without it: no sync, no orders, no admin writes.
SUPABASE_SERVICE_ROLE_KEY=

# ────────────────────────────────────────────────────────────
# ADMIN  (server-only)
# ────────────────────────────────────────────────────────────
# The operator passcode. There is no default and no fallback.
# Without it: /admin/login says sign-in is unavailable.
ADMIN_PASSWORD=

# HMAC key for the admin session cookie. Generate with:
#   openssl rand -base64 48
# Rotating it signs every existing session out immediately.
# Without it: sign-in is unavailable.
ADMIN_SESSION_SECRET=

# ────────────────────────────────────────────────────────────
# CRON  (server-only)
# ────────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
# Without it: /api/sync/* is reachable only with an admin session,
# so scheduled syncs stop. It is never publicly callable.
CRON_SECRET=

# ────────────────────────────────────────────────────────────
# STRIPE  (server-only except the publishable key)
# ────────────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY: checkout returns 503 and the cart
# says checkout is unavailable. There is no demo mode.
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook, from the Stripe
# dashboard or `stripe listen`.
# Without it: the webhook refuses every delivery, so orders are
# never recorded and stock is never decremented.
STRIPE_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────
# YOUTUBE  (server-only)
# ────────────────────────────────────────────────────────────
# console.cloud.google.com → enable YouTube Data API v3 → API key.
# The uploads playlist id is the channel id with UC swapped for UU.
# Without these: no YouTube rows in the archive.
YOUTUBE_API_KEY=
YOUTUBE_UPLOADS_PLAYLIST_ID=UUYEdpldm-qXYaT2xae1_ndQ
YOUTUBE_UPLOADS_PLAYLIST_ID_2=UUFa90RcysqjyYzTTrK6F3IQ

# ────────────────────────────────────────────────────────────
# TWITCH  (server-only)
# ────────────────────────────────────────────────────────────
# dev.twitch.tv → register an application → client id + secret.
# Without these: no VODs in the archive and the live banner never
# appears. The embed parent is derived from NEXT_PUBLIC_SITE_URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=wockkingdaggerr

# ────────────────────────────────────────────────────────────
# TIKTOK  (server-only, optional)
# ────────────────────────────────────────────────────────────
# Needs an approved developer app with the video.list scope.
# Without it: no TikTok rows. The profile is still linked.
TIKTOK_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────
# INSTAGRAM  (server-only, optional)
# ────────────────────────────────────────────────────────────
# Business/Creator account + long-lived token (expires every 60
# days — see docs/RUNBOOK.md for the refresh).
# Without these: no Instagram rows. The profile is still linked.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────
# MONITORING  (server-only, optional)
# ────────────────────────────────────────────────────────────
# Sentry DSN. Errors are forwarded over the ingest API — no SDK,
# no bundle cost. Values that look like secrets are redacted first.
# Without it: errors are still logged as JSON to the Vercel logs.
SENTRY_DSN=
